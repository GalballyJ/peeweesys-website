      <LABEL index="5" value="6"/>
      <MATH equation="X">
        <VAR id="X"/>
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y">
      <units>-</units>
      <indexcount>1</indexcount>
      <decimalpl>0</decimalpl>
      <outputtype>2</outputtype>
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0"/>
      <LABEL index="0" value=""/>
      <MATH equation="X">
        <VAR id="X"/>
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <units>factor (1/256 scale)</units>
      <decimalpl>2</decimalpl>
      <min>0.0</min>
      <outputtype>1</outputtype>
      <EMBEDDEDDATA mmedaddress="0x122ce" mmedelementsizebits="8" mmedrowcount="1" mmedcolcount="6" signed="0"/>
      <MATH equation="1.0 * X">
