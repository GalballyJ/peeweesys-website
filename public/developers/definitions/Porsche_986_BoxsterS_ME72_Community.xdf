      <embedinfo type="1"/>
      <MATH equation="0.0015258789*X">
        <VAR id="X"/>
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y">
      <units>nmot (RPM)</units>
      <indexcount>16</indexcount>
      <decimalpl>2</decimalpl>
      <EMBEDDEDDATA mmedaddress="0x15c06" mmedelementsizebits="16" mmedmajorstridebits="16" mmedtypeflags="0x00" lsbfirst="1"/>
      <embedinfo type="1"/>
      <MATH equation="0.25*X">
        <VAR id="X"/>
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="z">
      <units>Load % fill</units>
      <decimalpl>2</decimalpl>
      <min>0.0</min>
      <outputtype>1</outputtype>
