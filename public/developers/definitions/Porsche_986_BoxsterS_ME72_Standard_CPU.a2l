ASAP2_VERSION 1 61
/begin PROJECT ME72_986BoxsterS "Porsche 986 Boxster S ME7.2 ROM 91003718 - Standard_CPU"
  /begin MODULE ME72 "ME7.2 3.2L Calibration"
    /begin MOD_COMMON "Bosch ME7.2 C167CR Little Endian"
      BYTE_ORDER MSB_LAST
      ALIGNMENT_BYTE 1
      ALIGNMENT_WORD 1
      ALIGNMENT_LONG 1
    /end MOD_COMMON

    /begin COMPU_METHOD CM_IGN "Ignition timing angle" LINEAR "%.2f" "deg BTDC"
      COEFFS_LINEAR 0.75 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_IGN_DELTA "Knock retard timing delta" LINEAR "%.2f" "deg BTDC"
      COEFFS_LINEAR 0.75 -96
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_LAMBDA "Lambda ratio" LINEAR "%.3f" "lambda"
      COEFFS_LINEAR 0.0078125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_KGH "Mass airflow kg/h" LINEAR "%.1f" "kg/h"
      COEFFS_LINEAR 0.1 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_LOAD_RLKR "Knock retard relative engine load" LINEAR "%.1f" "%"
      COEFFS_LINEAR 0.75 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_LOAD_RL "Relative engine load" LINEAR "%.1f" "%"
      COEFFS_LINEAR 0.75 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_LOAD_FILL "Relative cylinder charge fill" LINEAR "%.2f" "%"
      COEFFS_LINEAR 0.0234375 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_LOAD_LAMFA "LAMFA load axis" LINEAR "%.1f" "%"
      COEFFS_LINEAR 0.0030517578 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_RPM_40 "Engine speed in RPM (x40)" LINEAR "%.0f" "rpm"
      COEFFS_LINEAR 40 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_RPM_Q025 "Engine speed in RPM (x0.25)" LINEAR "%.0f" "rpm"
      COEFFS_LINEAR 0.25 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_RPM_10 "Engine speed in RPM (x10)" LINEAR "%.0f" "rpm"
      COEFFS_LINEAR 10 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_PERCENT_UWORD "16-bit Percentage 0-100%" LINEAR "%.1f" "%"
      COEFFS_LINEAR 0.0015259022 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_PERCENT_BYTE "8-bit Percentage 0-100%" LINEAR "%.1f" "%"
      COEFFS_LINEAR 0.3921568627 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_TORQUE_OPT "Optimal torque percentage" LINEAR "%.2f" "%"
      COEFFS_LINEAR 0.0015258789 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_FACTOR_00078 "Generic multiplier factor" LINEAR "%.4f" "-"
      COEFFS_LINEAR 0.0078125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_FACTOR_URL "VarioCam pressure conversion factor" LINEAR "%.6f" "-"
      COEFFS_LINEAR 0.0000045776 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_OUTFLOW_KLAF "Throttle body outflow factor" LINEAR "%.4f" "-"
      COEFFS_LINEAR 0.0000152587890625 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_TEMP_C "Temperature in deg C" LINEAR "%.1f" "deg C"
      COEFFS_LINEAR 0.75 -48
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_TEMP_NERNST "Nernst Temperature in deg C" LINEAR "%.1f" "deg C"
      COEFFS_LINEAR 5 -50
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_RES_NERNST "Nernst Resistance in Ohms" LINEAR "%.0f" "Ohm"
      COEFFS_LINEAR 8 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_FLOW_NERNST "Exhaust Flow Factor" LINEAR "%.2f" "-"
      COEFFS_LINEAR 0.01 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_PULSE_MS "Injection pulse duration" LINEAR "%.2f" "ms"
      COEFFS_LINEAR 0.05 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_DWELL_MS "Coil dwell duration" LINEAR "%.2f" "ms"
      COEFFS_LINEAR 0.01 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_BATTERY_V "Battery voltage" LINEAR "%.2f" "V"
      COEFFS_LINEAR 0.00244140625 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_CAM_ANGLE "Camshaft angle" LINEAR "%.2f" "deg KW"
      COEFFS_LINEAR 0.0019 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_CAM_SPREAD "Camshaft spread" LINEAR "%.2f" "deg KW"
      COEFFS_LINEAR 0.0078125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_VOLTS "Sensor voltage" LINEAR "%.3f" "V"
      COEFFS_LINEAR 0.0048828125 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_SU_STATE "Flap State: 0=Closed, 1=Debounce, 2=Open" IDENTICAL "%.0f" "state"
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_IDENT "Raw integer index" IDENTICAL "%.0f" "-"
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_WARMUP_DELTA "Warmup spark advance delta" LINEAR "%.2f" "deg BTDC"
      COEFFS_LINEAR 0.75 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_PURGE_PERIOD "Purge valve period in ms" LINEAR "%.1f" "ms"
      COEFFS_LINEAR 0.5 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_THROTTLE_ANGLE "Throttle blade angle percentage" LINEAR "%.2f" "%"
      COEFFS_LINEAR 0.0015259022 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_PEDAL_TORQUE "Pedal driver demand percentage" LINEAR "%.2f" "%"
      COEFFS_LINEAR 0.0030517578 0
    /end COMPU_METHOD
    /begin COMPU_METHOD CM_DRAG_TORQUE "Mechanical drag torque percentage" LINEAR "%.2f" "%"
      COEFFS_LINEAR 0.0015259022 0
    /end COMPU_METHOD


    /begin RECORD_LAYOUT RL_UBYTE
      FNC_VALUES 1 UBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_SBYTE
      FNC_VALUES 1 SBYTE ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_UWORD
      FNC_VALUES 1 UWORD ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_SWORD
      FNC_VALUES 1 SWORD ROW_DIR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_AXIS_UBYTE
      AXIS_PTS_X 1 UBYTE INDEX_INCR DIRECT
    /end RECORD_LAYOUT
    /begin RECORD_LAYOUT RL_AXIS_UWORD
      AXIS_PTS_X 1 UWORD INDEX_INCR DIRECT
    /end RECORD_LAYOUT

