---
// Contact & Inquiry Section with Client-Side Mailto Generator
const recipientEmail = "info@peeweesys.com";
---

<section id="contact" class="py-24 bg-pw-card/40 relative border-t border-pw-line">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pw-red/10 text-pw-red border border-pw-red/20 text-xs font-semibold uppercase tracking-wider">
        Get in Touch
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-pw-text tracking-tight">
        Questions, Early Access & Vehicle Logs
      </h2>
      <p class="text-base text-pw-muted leading-relaxed">
        Have questions about cable setups, want to test your Porsche with the demo interface, or have vehicle traces to contribute? Fill in the details below to draft an email directly to the maintainer.
      </p>
    </div>

    <!-- Contact Form Box -->
    <div class="rounded-2xl bg-pw-panel border border-pw-line p-8 sm:p-10 shadow-2xl">
      <form id="contact-form" class="space-y-6">
        <!-- Name & Email Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider font-mono text-pw-text">
              Your Name
            </label>
            <input
              type="text"
              id="contact-name"
              required
              placeholder="e.g. Ferdinand"
              class="w-full px-4 py-3 rounded-lg bg-pw-card border border-pw-line focus:border-pw-red focus:ring-1 focus:ring-pw-red text-sm text-pw-text placeholder-pw-muted/50 transition-colors"
            />
          </div>

          <div class="space-y-2">
            <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider font-mono text-pw-text">
              Your Email Address
            </label>
            <input
              type="email"
              id="contact-email"
              required
              placeholder="name@example.com"
              class="w-full px-4 py-3 rounded-lg bg-pw-card border border-pw-line focus:border-pw-red focus:ring-1 focus:ring-pw-red text-sm text-pw-text placeholder-pw-muted/50 transition-colors"
            />
          </div>
        </div>

        <!-- Vehicle Model & Subject Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="contact-vehicle" class="block text-xs font-bold uppercase tracking-wider font-mono text-pw-text">
              Porsche Model & Year
            </label>
            <input
              type="text"
              id="contact-vehicle"
              placeholder="e.g. 2001 Boxster S 3.2L (986)"
              class="w-full px-4 py-3 rounded-lg bg-pw-card border border-pw-line focus:border-pw-red focus:ring-1 focus:ring-pw-red text-sm text-pw-text placeholder-pw-muted/50 transition-colors"
            />
          </div>

          <div class="space-y-2">
            <label for="contact-topic" class="block text-xs font-bold uppercase tracking-wider font-mono text-pw-text">
              Topic / Inquiry Type
            </label>
            <select
              id="contact-topic"
              class="w-full px-4 py-3 rounded-lg bg-pw-card border border-pw-line focus:border-pw-red focus:ring-1 focus:ring-pw-red text-sm text-pw-text transition-colors"
            >
              <option value="Demo UI & Early Access">Demo UI & Early Access Invitation</option>
              <option value="Commercial & Shop Licensing">Commercial / Independent Shop Inquiries</option>
              <option value="Cable & Hardware Advice">FTDI Cable & Pin 3/7 Switch Advice</option>
              <option value="ECU Diagnostic Question">ECU Diagnostic Question</option>
              <option value="Gauge & Speedo Linearization">Coolant Gauge / Speedo Linearization</option>
              <option value="Vehicle Log Contribution">Vehicle Log & Trace Contribution</option>
              <option value="General Feedback">General Feedback & Collaboration</option>
            </select>
          </div>
        </div>

        <!-- Message Field -->
        <div class="space-y-2">
          <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider font-mono text-pw-text">
            Your Message
          </label>
          <textarea
            id="contact-message"
            rows="5"
            required
            placeholder="Tell us about your Porsche, your setup, or what you'd like to diagnose..."
            class="w-full px-4 py-3 rounded-lg bg-pw-card border border-pw-line focus:border-pw-red focus:ring-1 focus:ring-pw-red text-sm text-pw-text placeholder-pw-muted/50 transition-colors resize-y"
          ></textarea>
        </div>

        <!-- Form Footer & Submit -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-pw-muted">
            Direct Email: <a href={`mailto:${recipientEmail}`} class="text-pw-text hover:text-pw-red underline">{recipientEmail}</a>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3.5 rounded-lg bg-pw-red hover:bg-pw-guardsred text-white font-bold text-sm shadow-glow-red transition-all duration-200 transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
          >
            <span>Draft Email in Mail Client</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<!-- Client-side Mailto Dispatcher Script -->
<script define:vars={{ recipientEmail }}>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = document.getElementById('contact-name')?.value || '';
      const email = document.getElementById('contact-email')?.value || '';
      const vehicle = document.getElementById('contact-vehicle')?.value || 'Not Specified';
      const topic = document.getElementById('contact-topic')?.value || 'General Inquiry';
      const message = document.getElementById('contact-message')?.value || '';

      const subject = encodeURIComponent(`[PeeweeSys] ${topic} - ${vehicle}`);
      const body = encodeURIComponent(
        `Hi PeeweeSys Team,\n\n${message}\n\n---\nSender: ${name}\nEmail: ${email}\nVehicle: ${vehicle}\nTopic: ${topic}`
      );

      const mailtoUrl = `mailto:${recipientEmail}?subject=${subject}&body=${body}`;
      window.location.href = mailtoUrl;
    });
  }
</script>
