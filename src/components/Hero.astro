---
// Hero Section with Porsche tachometer aesthetics, vehicle vector silhouettes, and live diagnostic preview
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-32 dial-grid">
  <!-- Radial Glow Behind Hero -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-b from-pw-red/15 via-pw-guardsred/5 to-transparent blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <!-- Status Badges Row -->
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pw-green/15 text-pw-green border border-pw-green/30 font-medium font-mono">
            <span class="w-2 h-2 rounded-full bg-pw-green"></span>
            <span>Windows: Supported Now</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pw-panel text-pw-muted border border-pw-line font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-pw-amber"></span>
            <span>macOS: Coming Soon</span>
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pw-panel text-pw-muted border border-pw-line font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-pw-muted"></span>
            <span>iOS & Android: Coming Soon</span>
          </div>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-pw-text leading-[1.08]">
          Dealer-level <span class="text-transparent bg-clip-text bg-gradient-to-r from-pw-red via-red-500 to-rose-400">(and beyond)</span> Porsche diagnostics in your browser.
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-pw-muted leading-relaxed font-normal max-w-2xl">
          Grab any cheap <strong>$15 Amazon cable</strong>, plug into your <strong>Porsche</strong>, and diagnose immediately. Free core read diagnostics, open community improvement, and affordable <strong>lifetime-per-car unlocks</strong> for advanced features.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-lg bg-pw-red hover:bg-pw-guardsred text-white text-base font-bold shadow-glow-red transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            <span>Interactive Demo UI (Coming Soon)</span>
          </a>

          <a
            href="#comparison"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-lg bg-pw-panel hover:bg-pw-surface text-pw-text border border-pw-line hover:border-pw-muted/40 font-semibold text-base transition-colors"
          >
            <span>Compare With Durametric & PIWIS</span>
            <svg class="w-4 h-4 text-pw-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>

        <!-- Trust & Tech Proof Bar -->
        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-pw-line/70 max-w-lg">
          <div>
            <div class="text-2xl font-bold font-mono text-pw-text">$15 Cable</div>
            <div class="text-xs text-pw-muted">Standard FTDI USB OBD-II cable</div>
          </div>
          <div>
            <div class="text-2xl font-bold font-mono text-pw-green">Free Core</div>
            <div class="text-xs text-pw-muted">Read codes & live data for everyone</div>
          </div>
          <div>
            <div class="text-2xl font-bold font-mono text-pw-text">Per-Car</div>
            <div class="text-xs text-pw-muted">Lifetime unlock for advanced writes</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Diagnostic Terminal & Vehicle Silhouette Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl bg-pw-panel border border-pw-line shadow-2xl overflow-hidden">
          <!-- Terminal Header -->
          <div class="flex items-center justify-between px-4 py-3 bg-pw-card border-b border-pw-line">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-pw-red"></span>
              <span class="w-3 h-3 rounded-full bg-pw-amber"></span>
              <span class="w-3 h-3 rounded-full bg-pw-green"></span>
              <span class="ml-2 text-xs font-mono text-pw-muted">PeeweeSys Diagnostic Console :: 986 Boxster S</span>
            </div>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-pw-green/20 text-pw-green border border-pw-green/30">
              CONNECTED
            </span>
          </div>

          <!-- Vehicle Silhouette Backdrop with Tachometer Accent -->
          <div class="relative bg-gradient-to-b from-pw-card via-pw-panel to-pw-bg p-6 flex flex-col items-center justify-center border-b border-pw-line">
            <!-- Vector Vehicle Silhouette - Matched 986 Boxster S -->
            <div class="w-full max-w-xs h-28 flex items-center justify-center relative">
              <img
                src="/assets/vehicles/svg/dark/986-1-s.svg"
                alt="Porsche 986 Boxster S Silhouette"
                class="w-full h-auto max-h-24 object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)] opacity-95 transition-transform hover:scale-105 duration-300"
              />
            </div>
            <div class="flex items-center justify-between w-full text-xs font-mono pt-3 border-t border-pw-line/50 text-pw-muted">
              <span>Model: 2001 Boxster S 3.2L</span>
              <span>Bus: K-Line Pin 7 / 3</span>
              <span>Status: Online</span>
            </div>
          </div>

          <!-- Live Telemetry & ECU Stream -->
          <div class="p-4 bg-pw-card/80 font-mono text-xs space-y-2.5">
            <div class="flex items-center justify-between text-pw-muted">
              <span class="text-pw-green font-medium">VIN Detected:</span>
              <span class="text-pw-text">WP0CB29811U62xxxx</span>
            </div>
            <div class="flex items-center justify-between text-pw-muted">
              <span class="text-pw-green font-medium">ECU Identified:</span>
              <span class="text-pw-text">Bosch ME7.2 (Boxster S)</span>
            </div>
            <div class="flex items-center justify-between text-pw-muted">
              <span class="text-pw-green font-medium">Engine Telemetry:</span>
              <span class="text-pw-text">Coolant: 84°C | RPM: 780</span>
            </div>
            <div class="flex items-center justify-between text-pw-muted">
              <span class="text-pw-amber font-medium">Cluster Calibration:</span>
              <span class="text-pw-text">Gauge Buffer Linearized</span>
            </div>
            <div class="mt-3 pt-3 border-t border-pw-line flex items-center justify-between text-[11px]">
              <span class="text-pw-muted">Cross-Module Mileage Audit:</span>
              <span class="text-pw-green font-bold">DME 84,210 km == Kombi 84,215 km (MATCH)</span>
            </div>
          </div>

          <!-- Footer Badge Inside Card -->
          <div class="px-4 py-2.5 bg-pw-panel/90 border-t border-pw-line flex items-center justify-between text-xs">
            <span class="text-pw-muted">Over-Rev History:</span>
            <span class="text-pw-text font-mono">Range 1: 34 / Range 2: 0 (Clean Engine)</span>
          </div>
        </div>

        <!-- Floating Decorative Badge -->
        <div class="absolute -bottom-5 -left-5 bg-pw-card border border-pw-line shadow-xl rounded-xl p-3 hidden sm:flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-pw-green/10 border border-pw-green/30 flex items-center justify-center text-pw-green font-bold">
            PPI
          </div>
          <div>
            <div class="text-xs font-bold text-pw-text">Guided Pre-Purchase Dossier</div>
            <div class="text-[11px] text-pw-muted">Live step-by-step health logging</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
