---
// KombiStudioShowcase.astro - Interactive WYSIC Instrument Cluster & Pro EEPROM Suite Showcase
import { renderClusterSvg } from '../lib/pws_cluster.js';

// Pre-render default 986.2 Boxster S (3-dial, K24 dot-matrix, 180 MPH) for instant SSR
const defaultSvg = renderClusterSvg({
  dials: 3,
  faceTheme: 'black',
  display: 'k24',
  numerals: 'italic',
  scaleId: '180_mph',
  speedPred: { indicatedDisplay: 60, trueDisplay: 60 },
  digitalSpeed: 60,
  rpm: 4000,
  coolantPred: { indicatedC: 80 },
  fuelPred: { indicatedPct: 75 },
  odometer: '064120',
  trip: '228.7',
  clock: '14:25',
  clockFormat: '24',
  pm: { obc_enabled: true, cruise: false },
  idPrefix: 'wysic-live',
  embedFonts: true
});
---

<section id="kombi-studio" class="py-24 bg-pw-card/40 relative border-t border-pw-line overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pw-red/10 text-pw-red border border-pw-red/20 text-xs font-semibold uppercase tracking-wider font-mono">
        World-First Innovation &bull; WYSIC Studio
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold text-pw-text tracking-tight">
        What You See Is What You Code.
      </h2>
      <p class="text-base sm:text-lg text-pw-muted leading-relaxed">
        Say goodbye to cryptic hexadecimal bitmasks and risky dealer coding. PeeweeSys renders your exact 986 / 996 VDO instrument cluster in real-time SVG — letting you preview retrofits, needle calibrations, dial scales, and OBC displays visually before writing a single byte.
      </p>
    </div>

    <!-- Interactive Visual Cluster Showcase Card -->
    <div class="rounded-2xl bg-pw-panel border border-pw-line shadow-2xl p-6 sm:p-10 mb-16 relative">
      <!-- Top Bar: Preset Selection Tabs & Coding Toggles -->
      <div class="space-y-6 pb-6 border-b border-pw-line/70 mb-8">
        <!-- Row 1: Cluster Platform / Generation Selector -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono text-pw-red uppercase tracking-wider font-bold">Step 1 &bull; Select Instrument Cluster</span>
            <h3 class="text-xl sm:text-2xl font-bold text-pw-text">Kombi 2000 Visual Coding Studio</h3>
          </div>

          <!-- 3-Way Cluster Generation Selector Tabs -->
          <div class="inline-flex p-1 rounded-xl bg-pw-card border border-pw-line gap-1 self-start lg:self-auto" role="tablist">
            <button
              type="button"
              id="preset-986-1"
              data-preset="986.1-lcd"
              class="wysic-preset-btn px-3.5 py-2 rounded-lg text-xs font-mono font-semibold transition-all text-pw-muted hover:text-pw-text flex items-center gap-2"
              title="986.1 Boxster with classic segment LCD displays"
            >
              <span>986.1 LCD</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-pw-surface border border-pw-line text-zinc-400">1997–00</span>
            </button>

            <button
              type="button"
              id="preset-986-2"
              data-preset="986.2-dot"
              class="wysic-preset-btn px-3.5 py-2 rounded-lg text-xs font-mono font-semibold transition-all bg-pw-red text-white shadow-md shadow-pw-red/20 font-bold border border-pw-red flex items-center gap-2"
              title="986.2 Boxster S with K24 high-res amber dot-matrix display and 180 MPH scale"
            >
              <span>986.2 Dot-Matrix</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-black/30 border border-white/20 text-white font-mono">180 MPH S</span>
            </button>

            <button
              type="button"
              id="preset-996-2"
              data-preset="996.2-dot"
              class="wysic-preset-btn px-3.5 py-2 rounded-lg text-xs font-mono font-semibold transition-all text-pw-muted hover:text-pw-text flex items-center gap-2"
              title="996.2 911 Carrera with 5 dials (voltmeter and oil pressure pods) and dot-matrix center"
            >
              <span>996.2 5-Dial</span>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-pw-surface border border-pw-line text-zinc-400">911 VDO</span>
            </button>
          </div>
        </div>

        <!-- Row 2: Live Feature & Calibration Toggles -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-pw-line/40">
          <span class="text-xs font-mono text-pw-muted uppercase tracking-wider font-semibold">Step 2 &bull; Toggle Features &amp; Calibrations:</span>

          <div class="flex flex-wrap items-center gap-2">
            <!-- 1:1 Speedo vs OEM Over-Read -->
            <button
              type="button"
              id="wysic-btn-speedo"
              class="px-3 py-1.5 rounded-lg border border-pw-line bg-pw-card hover:bg-pw-surface text-pw-text text-xs font-mono font-semibold transition-all flex items-center gap-2 shadow-sm"
              title="Toggle speedometer calibration between 1:1 GPS true speed and OEM +7% over-read"
            >
              <span class="w-2 h-2 rounded-full bg-pw-green" id="wysic-dot-speedo"></span>
              <span id="wysic-text-speedo">1:1 True Speedo</span>
            </button>

            <!-- OBC Retrofit Toggle -->
            <button
              type="button"
              id="wysic-btn-obc"
              class="px-3 py-1.5 rounded-lg border border-pw-line bg-pw-card hover:bg-pw-surface text-pw-text text-xs font-mono font-semibold transition-all flex items-center gap-2 shadow-sm"
              title="Enable or disable 4-stalk On-Board Computer retrofit display"
            >
              <span class="w-2 h-2 rounded-full bg-amber-400" id="wysic-dot-obc"></span>
              <span id="wysic-text-obc">OBC: Enabled</span>
            </button>

            <!-- Cruise Control Lamp Toggle -->
            <button
              type="button"
              id="wysic-btn-cruise"
              class="px-3 py-1.5 rounded-lg border border-pw-line bg-pw-card hover:bg-pw-surface text-pw-text text-xs font-mono font-semibold transition-all flex items-center gap-2 shadow-sm"
              title="Toggle cruise control telltale indicator"
            >
              <span class="w-2 h-2 rounded-full bg-zinc-600" id="wysic-dot-cruise"></span>
              <span id="wysic-text-cruise">Cruise Lamp: Off</span>
            </button>

            <!-- Imperial vs Metric Toggle -->
            <button
              type="button"
              id="wysic-btn-scale"
              class="px-3 py-1.5 rounded-lg border border-pw-line bg-pw-card hover:bg-pw-surface text-pw-text text-xs font-mono font-semibold transition-all flex items-center gap-2 shadow-sm"
              title="Toggle between Imperial (MPH / °F) and Metric (km/h / °C)"
            >
              <span class="w-2 h-2 rounded-full bg-pw-blue" id="wysic-dot-scale"></span>
              <span id="wysic-text-scale">Imperial (MPH / &deg;F)</span>
            </button>

            <!-- Dial Face Theme: Black vs White/Chrome -->
            <button
              type="button"
              id="wysic-btn-theme"
              class="px-3 py-1.5 rounded-lg border border-pw-line bg-pw-card hover:bg-pw-surface text-pw-text text-xs font-mono font-semibold transition-all flex items-center gap-2 shadow-sm"
              title="Toggle dial face color between Factory Black and Carrera White / Silver with chrome bezels"
            >
              <span class="w-2 h-2 rounded-full bg-zinc-400" id="wysic-dot-theme"></span>
              <span id="wysic-text-theme">Black Faces</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Real-Time SVG Cluster Display Container -->
      <div id="wysic-cluster-container" class="w-full flex justify-center py-4 sm:py-6 overflow-x-auto select-none" set:html={defaultSvg} />

      <!-- Feature Callout Badges Under Cluster -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 border-t border-pw-line/70 text-xs font-mono">
        <div class="p-3 rounded-lg bg-pw-card/80 border border-pw-line flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 shrink-0 font-bold">1</div>
          <div>
            <div class="text-pw-text font-bold">OBC Stalk &amp; Telltale Preview</div>
            <div class="text-pw-muted text-[11px]">Preview Range, MPG &amp; Temp displays before adding 4-stalk assembly</div>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-pw-card/80 border border-pw-line flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-pw-green/10 border border-pw-green/30 flex items-center justify-center text-pw-green shrink-0 font-bold">2</div>
          <div>
            <div class="text-pw-text font-bold">GPS 1:1 Speedo Calibration</div>
            <div class="text-pw-muted text-[11px]">Simulates OEM +7% over-read vs calibrated uk_1to1 impulse ratio with green calibration mark</div>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-pw-card/80 border border-pw-line flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-pw-blue/10 border border-pw-blue/30 flex items-center justify-center text-pw-blue shrink-0 font-bold">3</div>
          <div>
            <div class="text-pw-text font-bold">Instant Safe Rollback</div>
            <div class="text-pw-muted text-[11px]">Cryptographic byte backup taken before any write with one-click restore</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pro Auto Electrician EEPROM Suite Grid -->
    <div class="space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/20 text-xs font-semibold uppercase tracking-wider font-mono">
          Specialist Capability &bull; In Beta
        </div>
        <h3 class="text-2xl sm:text-3xl font-bold text-pw-text">Pro Auto Electrician &amp; EEPROM Suite</h3>
        <p class="text-sm text-pw-muted">
          Designed for independent Porsche specialists, auto electricians, and cluster repair technicians.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1: OBD EEPROM Write -->
        <div class="p-6 rounded-xl bg-pw-panel border border-pw-line hover:border-amber-400/40 transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-lg bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h4 class="text-base font-bold text-pw-text">OBD EEPROM Flashing (0x3D)</h4>
            <p class="text-xs text-pw-muted leading-relaxed">
              Read and write the late VDO Kombi 2000 (93C86 2048-byte) EEPROM directly over OBD. Completely eliminates instrument cluster removal, needle pulling, crystal grounding, and SOIC clip bench programming.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-pw-line/60 flex items-center gap-2 text-[11px] font-mono text-amber-400">
            <span>&check; 93C86 2048B OBD Support</span>
          </div>
        </div>

        <!-- Feature 2: One-Click Virginize -->
        <div class="p-6 rounded-xl bg-pw-panel border border-pw-line hover:border-pw-green/40 transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-lg bg-pw-green/10 border border-pw-green/30 flex items-center justify-center text-pw-green">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </div>
            <h4 class="text-base font-bold text-pw-text">Donor Cluster Virginizer</h4>
            <p class="text-xs text-pw-muted leading-relaxed">
              Official dealer tools permanently lock out used donor clusters with over 100 km, demanding $2,500 new replacement parts. Our suite wipes the odometer block below 100 km and resets commissioning flags for factory PST2/PIWIS pairing.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-pw-line/60 flex items-center gap-2 text-[11px] font-mono text-pw-green">
            <span>&check; Bypass 100 km Lockout</span>
          </div>
        </div>

        <!-- Feature 3: DVSA MOT Mileage Cross-Check -->
        <div class="p-6 rounded-xl bg-pw-panel border border-pw-line hover:border-pw-blue/40 transition-all flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-lg bg-pw-blue/10 border border-pw-blue/30 flex items-center justify-center text-pw-blue">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h4 class="text-base font-bold text-pw-text">Gov MOT History Odometer Audit</h4>
            <p class="text-xs text-pw-muted leading-relaxed">
              Connects directly to the UK DVSA / DVLA MOT History database. Automatically compares multi-module VINs across DME (0x11), Kombi (0x64), and Alarm (0xC0) against official government test station records to instantly uncover odometer tampering.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-pw-line/60 flex items-center gap-2 text-[11px] font-mono text-pw-blue">
            <span>&check; Live DVSA API Integration</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Interactive Cluster Client Controller -->
<script>
  import { renderClusterSvg } from '../lib/pws_cluster.js';

  (function () {
    const container = document.getElementById('wysic-cluster-container');
    if (!container) return;

    // Preset Selection Buttons
    const presetBtns = document.querySelectorAll('.wysic-preset-btn');

    // Feature Toggle Buttons
    const btnSpeedo = document.getElementById('wysic-btn-speedo');
    const dotSpeedo = document.getElementById('wysic-dot-speedo');
    const textSpeedo = document.getElementById('wysic-text-speedo');

    const btnObc = document.getElementById('wysic-btn-obc');
    const dotObc = document.getElementById('wysic-dot-obc');
    const textObc = document.getElementById('wysic-text-obc');

    const btnCruise = document.getElementById('wysic-btn-cruise');
    const dotCruise = document.getElementById('wysic-dot-cruise');
    const textCruise = document.getElementById('wysic-text-cruise');

    const btnScale = document.getElementById('wysic-btn-scale');
    const dotScale = document.getElementById('wysic-dot-scale');
    const textScale = document.getElementById('wysic-text-scale');

    const btnTheme = document.getElementById('wysic-btn-theme');
    const dotTheme = document.getElementById('wysic-dot-theme');
    const textTheme = document.getElementById('wysic-text-theme');

    // Studio Configuration State
    // Preset: '986.1-lcd' | '986.2-dot' | '996.2-dot'
    let currentPreset = '986.2-dot';
    let isTrueSpeed = true; // 1:1 GPS calibrated vs OEM +7% over-read
    let isObcOn = true;
    let isCruiseOn = false;
    let isMetric = false; // Imperial (MPH/°F) vs Metric (km/h/°C)
    let faceTheme = 'black'; // 'black' | 'white'

    function updateCluster() {
      if (!container) return;

      let dials = 3;
      let display = 'k24';
      let scaleId = '180_mph';
      let numerals = 'italic';

      if (currentPreset === '986.1-lcd') {
        dials = 3;
        display = 'early';
        scaleId = isMetric ? '250_kmh' : '160_mph';
        numerals = 'italic';
      } else if (currentPreset === '986.2-dot') {
        dials = 3;
        display = 'k24';
        scaleId = isMetric ? '300_kmh' : '180_mph'; // 180 MPH Boxster S
        numerals = 'italic';
      } else if (currentPreset === '996.2-dot') {
        dials = 5;
        display = 'k24';
        scaleId = isMetric ? '300_kmh' : '200_mph';
        numerals = 'upright';
      }

      const speedVal = isMetric ? 100 : 60;
      const indicated = isTrueSpeed ? speedVal : (isMetric ? 108 : 66);

      const svg = renderClusterSvg({
        dials: dials,
        faceTheme: faceTheme,
        display: display,
        numerals: numerals,
        scaleId: scaleId,
        speedPred: {
          indicatedDisplay: indicated,
          trueDisplay: speedVal
        },
        digitalSpeed: speedVal,
        rpm: 4000,
        coolantPred: { indicatedC: 80 },
        tempUnit: isMetric ? 'C' : 'F',
        fuelPred: { indicatedPct: 75 },
        volts: 13.8,
        oilBar: 3.2,
        odometer: isMetric ? '103194' : '064120',
        trip: '228.7',
        clock: '14:25',
        clockFormat: '24',
        ambient: isMetric ? '14.5' : '52',
        pm: {
          obc_enabled: isObcOn,
          cruise: isCruiseOn,
          spoiler: dials === 5
        },
        idPrefix: 'wysic-live',
        embedFonts: true
      });

      container.innerHTML = svg;
    }

    // Handle Preset Switching
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const selected = btn.getAttribute('data-preset');
        if (!selected || selected === currentPreset) return;
        currentPreset = selected;

        // Update active tab styling
        presetBtns.forEach(b => {
          b.className = 'wysic-preset-btn px-3.5 py-2 rounded-lg text-xs font-mono font-semibold transition-all text-pw-muted hover:text-pw-text flex items-center gap-2';
          const badge = b.querySelector('span:last-child');
          if (badge) badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-pw-surface border border-pw-line text-zinc-400';
        });

        btn.className = 'wysic-preset-btn px-3.5 py-2 rounded-lg text-xs font-mono font-semibold transition-all bg-pw-red text-white shadow-md shadow-pw-red/20 font-bold border border-pw-red flex items-center gap-2';
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) activeBadge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-black/30 border border-white/20 text-white font-mono';

        updateCluster();
      });
    });

    // Toggle 1:1 GPS Calibrated Speedo
    if (btnSpeedo && dotSpeedo && textSpeedo) {
      btnSpeedo.addEventListener('click', () => {
        isTrueSpeed = !isTrueSpeed;
        if (isTrueSpeed) {
          dotSpeedo.className = 'w-2 h-2 rounded-full bg-pw-green';
          textSpeedo.textContent = '1:1 True Speedo';
        } else {
          dotSpeedo.className = 'w-2 h-2 rounded-full bg-amber-400';
          textSpeedo.textContent = 'OEM Over-Read (+7%)';
        }
        updateCluster();
      });
    }

    // Toggle OBC Retrofit
    if (btnObc && dotObc && textObc) {
      btnObc.addEventListener('click', () => {
        isObcOn = !isObcOn;
        if (isObcOn) {
          dotObc.className = 'w-2 h-2 rounded-full bg-amber-400';
          textObc.textContent = 'OBC: Enabled';
        } else {
          dotObc.className = 'w-2 h-2 rounded-full bg-zinc-600';
          textObc.textContent = 'OBC: Disabled (Odo Only)';
        }
        updateCluster();
      });
    }

    // Toggle Cruise Lamp
    if (btnCruise && dotCruise && textCruise) {
      btnCruise.addEventListener('click', () => {
        isCruiseOn = !isCruiseOn;
        if (isCruiseOn) {
          dotCruise.className = 'w-2 h-2 rounded-full bg-pw-green animate-pulse';
          textCruise.textContent = 'Cruise Lamp: Active';
        } else {
          dotCruise.className = 'w-2 h-2 rounded-full bg-zinc-600';
          textCruise.textContent = 'Cruise Lamp: Off';
        }
        updateCluster();
      });
    }

    // Toggle Imperial vs Metric
    if (btnScale && dotScale && textScale) {
      btnScale.addEventListener('click', () => {
        isMetric = !isMetric;
        if (isMetric) {
          dotScale.className = 'w-2 h-2 rounded-full bg-amber-400';
          textScale.textContent = 'Metric (km/h / \u00B0C)';
        } else {
          dotScale.className = 'w-2 h-2 rounded-full bg-pw-blue';
          textScale.textContent = 'Imperial (MPH / \u00B0F)';
        }
        updateCluster();
      });
    }

    // Toggle Face Theme (Black vs White/Chrome)
    if (btnTheme && dotTheme && textTheme) {
      btnTheme.addEventListener('click', () => {
        faceTheme = faceTheme === 'black' ? 'white' : 'black';
        if (faceTheme === 'white') {
          dotTheme.className = 'w-2 h-2 rounded-full bg-white';
          textTheme.textContent = 'Carrera White / Chrome';
        } else {
          dotTheme.className = 'w-2 h-2 rounded-full bg-zinc-400';
          textTheme.textContent = 'Black Faces';
        }
        updateCluster();
      });
    }
  })();
</script>
