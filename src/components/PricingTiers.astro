---
import tiersData from '../data/tiers.json';
const { tiers, guarantee } = tiersData;
---

<section id="pricing" class="py-24 bg-pw-bg relative border-t border-pw-line">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pw-red/10 text-pw-red border border-pw-red/20 text-xs font-semibold uppercase tracking-wider">
        Enthusiast-First Architecture
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-pw-text tracking-tight">
        Fair Pricing for Real Porsche Custodians.
      </h2>
      <p class="text-base sm:text-lg text-pw-muted leading-relaxed">
        Zero monthly subscriptions. Zero cloud telemetry lock-in. Core diagnostics are 100% free forever for every Porsche owner, with modular upgrades and lifetime garage packs when you need advanced write capabilities.
      </p>
    </div>

    <!-- Tiers Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {tiers.map((tier) => (
        <div
          class={`relative rounded-2xl flex flex-col justify-between p-8 transition-all duration-300 ${
            tier.highlight
              ? 'bg-pw-panel border-2 border-pw-red shadow-glow-red/20 scale-[1.02] z-10'
              : 'bg-pw-card border border-pw-line hover:border-pw-muted/40 shadow-xl'
          }`}
        >
          {tier.highlight && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-pw-red text-white text-xs font-mono font-bold tracking-wider uppercase shadow-md">
              {tier.badge}
            </div>
          )}

          <div class="space-y-6">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold text-pw-text">{tier.name}</h3>
                {!tier.highlight && (
                  <span class="text-xs font-mono text-pw-muted px-2 py-0.5 rounded bg-pw-panel border border-pw-line">
                    {tier.badge}
                  </span>
                )}
              </div>
              <p class="text-xs text-pw-muted leading-relaxed">{tier.tagline}</p>
            </div>

            <div class="pt-4 border-t border-pw-line/70">
              <div class="flex items-baseline gap-2">
                <span class="text-4xl font-bold font-mono text-pw-text">{tier.price}</span>
              </div>
              <div class="text-xs font-mono text-pw-muted mt-1">{tier.priceSub}</div>
            </div>

            <!-- Feature Bullet List -->
            <ul class="space-y-3 pt-4 border-t border-pw-line/70 text-xs">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-2.5 text-pw-text/90">
                  <span class="text-pw-green font-bold shrink-0 mt-0.5">&#10003;</span>
                  <span class="leading-relaxed">{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-8 mt-6 border-t border-pw-line/70">
            <a
              href={tier.ctaLink}
              class={`w-full py-3.5 px-6 rounded-lg font-bold text-sm text-center block transition-all duration-200 shadow-md ${
                tier.highlight
                  ? 'bg-pw-red hover:bg-pw-guardsred text-white shadow-glow-red'
                  : 'bg-pw-panel hover:bg-pw-surface text-pw-text border border-pw-line hover:border-pw-muted/50'
              }`}
            >
              {tier.cta} &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- "Pay the Difference" Lifetime Spend Guarantee Banner -->
    <div class="rounded-2xl bg-gradient-to-r from-pw-panel via-pw-card to-pw-panel border border-pw-line p-8 shadow-xl">
      <div class="flex flex-col md:flex-row items-center gap-6 justify-between">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-pw-green/10 border border-pw-green/30 flex items-center justify-center text-pw-green font-bold text-xl shrink-0">
            &pound;
          </div>
          <div class="space-y-1">
            <h4 class="text-lg font-bold text-pw-text flex items-center gap-2">
              <span>{guarantee.title}</span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-pw-green/20 text-pw-green font-bold uppercase">
                Anti-Penalty
              </span>
            </h4>
            <p class="text-xs sm:text-sm text-pw-muted leading-relaxed max-w-3xl">
              {guarantee.description} If you purchase a single $5 add-on or individual VIN unlock today, and later upgrade to the $49 Enthusiast Garage or $129 Specialist Tier, your past spending is deducted automatically. You only ever pay the difference.
            </p>
          </div>
        </div>

        <div class="shrink-0 font-mono text-xs text-pw-muted bg-pw-card px-4 py-2.5 rounded-lg border border-pw-line text-center">
          <span class="text-pw-green font-bold">100% CUMULATIVE CREDIT</span>
        </div>
      </div>
    </div>
  </div>
</section>
