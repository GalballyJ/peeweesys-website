---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PeeweeSys | Dealer-Level Porsche Diagnostics in Your Browser",
  description = "Diagnose your Porsche 986, 996, or 987 directly from your browser with a cheap $15 cable. ROM dumps, gauge linearization, over-rev audit, and live telemetry without Windows XP virtual machines."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/svg/peeweesys-mark-colour.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141619" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://peeweesys.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/brand/png/peeweesys-lockup-horizontal-on-dark@2x.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/assets/brand/png/peeweesys-lockup-horizontal-on-dark@2x.png" />
  </head>
  <body class="bg-pw-bg text-pw-text antialiased min-h-screen flex flex-col font-sans selection:bg-pw-red selection:text-white">
    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-pw-red/20 via-pw-panel to-pw-panel border-b border-pw-line text-xs py-2 px-4 text-center flex items-center justify-center gap-2">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-pw-green/20 text-pw-green font-mono font-medium text-[11px] border border-pw-green/30">
        <span class="w-1.5 h-1.5 rounded-full bg-pw-green animate-pulse"></span>
        CAR VERIFIED
      </span>
      <span class="text-pw-muted">986 & 996 field-tested on real vehicles. Interactive demo coming soon.</span>
      <a href="#contact" class="text-pw-red hover:text-white font-medium ml-1 underline decoration-pw-red/50 hover:decoration-white transition-colors">
        Join Early Access &rarr;
      </a>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-50 bg-pw-bg/90 backdrop-blur-md border-b border-pw-line transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-18">
          <!-- Logo Lockup -->
          <a href="/" class="flex items-center gap-3 group">
            <img
              src="/assets/brand/svg/peeweesys-lockup-horizontal-on-dark.svg"
              alt="PeeweeSys - Porsche Diagnostics"
              class="h-8 md:h-9 w-auto object-contain transition-transform group-hover:scale-[1.02]"
            />
          </a>

          <!-- Desktop Navigation Links -->
          <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
            <a href="#features" class="text-pw-muted hover:text-pw-text transition-colors">Killer Features</a>
            <a href="#comparison" class="text-pw-muted hover:text-pw-text transition-colors">Tool Matrix</a>
            <a href="#hardware" class="text-pw-muted hover:text-pw-text transition-colors">Cables & Pinouts</a>
            <a href="#vehicles" class="text-pw-muted hover:text-pw-text transition-colors">Vehicle Coverage</a>
            <a href="#pipeline" class="text-pw-muted hover:text-pw-text transition-colors">Engine Pipeline</a>
            <a href="#contact" class="text-pw-muted hover:text-pw-text transition-colors">Contact</a>
          </nav>

          <!-- Primary App Launch CTA (Coming Soon / Demo) -->
          <div class="hidden sm:flex items-center gap-4">
            <a
              href="#contact"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-pw-panel hover:bg-pw-surface text-pw-text border border-pw-red/40 hover:border-pw-red font-semibold text-sm transition-all duration-200"
            >
              <span class="w-2 h-2 rounded-full bg-pw-amber animate-pulse"></span>
              <span>Demo UI (Coming Soon)</span>
            </a>
          </div>

          <!-- Mobile Menu Button -->
          <div class="flex md:hidden items-center">
            <button
              id="mobile-menu-btn"
              type="button"
              aria-label="Toggle Navigation Menu"
              class="p-2 rounded-md text-pw-muted hover:text-pw-text hover:bg-pw-panel border border-pw-line"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div id="mobile-menu" class="hidden md:hidden py-4 border-t border-pw-line flex-col gap-3">
          <a href="#features" class="block py-2 text-pw-muted hover:text-pw-text font-medium">Killer Features</a>
          <a href="#comparison" class="block py-2 text-pw-muted hover:text-pw-text font-medium">Tool Matrix</a>
          <a href="#hardware" class="block py-2 text-pw-muted hover:text-pw-text font-medium">Cables & Pinouts</a>
          <a href="#vehicles" class="block py-2 text-pw-muted hover:text-pw-text font-medium">Vehicle Coverage</a>
          <a href="#pipeline" class="block py-2 text-pw-muted hover:text-pw-text font-medium">Engine Pipeline</a>
          <a href="#contact" class="block py-2 text-pw-muted hover:text-pw-text font-medium">Contact</a>
          <a
            href="#contact"
            class="mt-2 flex items-center justify-center gap-2 px-4 py-2.5 rounded-md bg-pw-panel border border-pw-red text-pw-text font-semibold text-sm"
          >
            Demo UI (Coming Soon) &rarr;
          </a>
        </div>
      </div>
    </header>

    <!-- Page Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <footer class="bg-pw-card border-t border-pw-line text-sm text-pw-muted py-14 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          <!-- Col 1: Brand & Philosophy -->
          <div class="space-y-4 md:col-span-1">
            <img
              src="/assets/brand/svg/peeweesys-lockup-horizontal-on-dark.svg"
              alt="PeeweeSys Logo"
              class="h-8 w-auto object-contain"
            />
            <p class="text-xs text-pw-muted leading-relaxed">
              Dealer-level (and beyond) Porsche diagnostics in your web browser. Free from $1,000 hardware locks, ancient laptops, and Windows XP virtual machines.
            </p>
            <div class="flex items-center gap-3 pt-2">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono bg-pw-panel border border-pw-line text-pw-text">
                OS: WebSerial / Chrome
              </span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono bg-pw-green/10 border border-pw-green/30 text-pw-green">
                Car-Verified 986/996
              </span>
            </div>
          </div>

          <!-- Col 2: Diagnostics & Features -->
          <div>
            <h4 class="text-xs uppercase tracking-wider font-semibold text-pw-text mb-4">Diagnostics</h4>
            <ul class="space-y-2.5 text-xs">
              <li><a href="#features" class="hover:text-pw-red transition-colors">Full ECU ROM Dumps (0x23)</a></li>
              <li><a href="#features" class="hover:text-pw-red transition-colors">Coolant Gauge Linearization</a></li>
              <li><a href="#features" class="hover:text-pw-red transition-colors">Kombi 93C86 EEPROM Read</a></li>
              <li><a href="#features" class="hover:text-pw-red transition-colors">Over-Rev & Operating Hours</a></li>
              <li><a href="#features" class="hover:text-pw-red transition-colors">Multi-Module Mileage Audit</a></li>
              <li><a href="#features" class="hover:text-pw-red transition-colors">Pre-Clear Snapshot Reports</a></li>
            </ul>
          </div>

          <!-- Col 3: Hardware & Platforms -->
          <div>
            <h4 class="text-xs uppercase tracking-wider font-semibold text-pw-text mb-4">Hardware & Vehicles</h4>
            <ul class="space-y-2.5 text-xs">
              <li><a href="#vehicles" class="hover:text-pw-red transition-colors">Porsche 986 Boxster</a></li>
              <li><a href="#vehicles" class="hover:text-pw-red transition-colors">Porsche 996 911 (Carrera/Turbo/GT3)</a></li>
              <li><a href="#vehicles" class="hover:text-pw-red transition-colors">Porsche 987 Boxster / Cayman</a></li>
              <li><a href="#vehicles" class="hover:text-pw-red transition-colors">Porsche 997 911</a></li>
              <li><a href="#hardware" class="hover:text-pw-red transition-colors">$15 FTDI K-Line Pin 7/3 Switch Mod</a></li>
              <li><a href="#hardware" class="hover:text-pw-red transition-colors">Tactrix OpenPort 2.0 (J2534)</a></li>
            </ul>
          </div>

          <!-- Col 4: Community & Contact -->
          <div>
            <h4 class="text-xs uppercase tracking-wider font-semibold text-pw-text mb-4">Community & Connect</h4>
            <ul class="space-y-2.5 text-xs">
              <li>
                <a href="#contact" class="text-pw-amber font-semibold hover:underline flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-pw-amber"></span>
                  <span>Demo UI (Coming Soon) &rarr;</span>
                </a>
              </li>
              <li><a href="#comparison" class="hover:text-pw-red transition-colors">Tool Comparison Matrix</a></li>
              <li><a href="#pipeline" class="hover:text-pw-red transition-colors">Live Development Pipeline</a></li>
              <li><a href="#contact" class="hover:text-pw-red transition-colors">Send Feedback or Inquiries</a></li>
              <li><a href="mailto:galballyj@hotmail.com" class="hover:text-pw-red transition-colors">Email Maintainer</a></li>
            </ul>
          </div>
        </div>

        <!-- Trademark Disclaimer & Copyright -->
        <div class="pt-8 border-t border-pw-line text-xs text-pw-muted/80 leading-relaxed flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
          <p class="max-w-3xl">
            <strong>Disclaimer:</strong> PeeweeSys is an independent open-source diagnostic project created for Porsche enthusiasts and DIY mechanics. 
            Porsche®, Boxster®, Carrera®, Cayman®, Tiptronic®, and PIWIS® are registered trademarks of Dr. Ing. h.c. F. Porsche AG. 
            PeeweeSys is not affiliated with, endorsed by, or associated with Porsche AG.
          </p>
          <div class="shrink-0 text-pw-muted text-right">
            &copy; {new Date().getFullYear()} PeeweeSys. All rights reserved.
          </div>
        </div>
      </div>
    </footer>

    <!-- Interactive Mobile Menu Toggle Script -->
    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
          mobileMenu.classList.toggle('flex');
        });

        // Close on link click
        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            mobileMenu.classList.remove('flex');
          });
        });
      }
    </script>
  </body>
</html>
